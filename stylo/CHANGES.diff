@@ -477,6 +477,86 @@ impl AnimationValue {
         })
     }
 
+    /// Snowlark patch 39: whether `property` (a physical longhand) has the same animated value in
+    /// both styles, decided from their computed values without building either `AnimationValue`,
+    /// as Blink's `CSSAnimations` compares the before-change and after-change styles
+    /// (`ComputedTransitionValuesEqual`, `CSSPropertyEquality::PropertiesEqual`) before it makes
+    /// any interpolable value. Equal computed values convert to equal animated values when the
+    /// conversion's other inputs are equal too: the effective zoom (lengths are unzoomed) and the
+    /// font size (`text-decoration-inset: auto`). `false` means "not known to be equal": custom
+    /// properties, logical and non-animatable longhands, and styles whose zoom or font size differ.
+    pub fn computed_values_equal(
+        property: PropertyDeclarationId,
+        a: &ComputedValues,
+        b: &ComputedValues,
+    ) -> bool {
+        let PropertyDeclarationId::Longhand(id) = property else {
+            return false;
+        };
+        if a.effective_zoom != b.effective_zoom || !a.font_size_equals(b) {
+            return false;
+        }
+        match id {
+            % for prop in data.longhands:
+            % if prop.animatable and not prop.logical:
+            LonghandId::${prop.camel_case} => {
+                std::ptr::eq(
+                    a.get_${prop.style_struct.name_lower}(),
+                    b.get_${prop.style_struct.name_lower}(),
+                ) || a.${prop.ident}_equals(b)
+            }
+            % endif
+            % endfor
+            _ => false,
+        }
+    }
+
+    /// Snowlark patch 49: for `transition-property: all`, calls `f` with each physical animatable
+    /// longhand of `all` whose transition can start or change between `a` and `b`, in the reverse
+    /// of `all`'s order (the order `start_transitions_if_applicable` takes them in): the longhands
+    /// of the style structs that differ (an unchanged struct holds equal values, as
+    /// `computed_values_equal` decides) and those in `existing` (the element's transitions). The
+    /// other longhands of `all` start nothing: they are logical (taken as their physical
+    /// longhand, which `all` also lists), not animatable, or equal with no transition. Returns
+    /// `false`, calling nothing, when the styles' zoom or font size differ (equal computed values
+    /// are then not known to be equal animated values). `all` lists its longhands by style struct,
+    /// so each struct is one test, as Blink compares the before-change and after-change styles'
+    /// shared data groups before their properties.
+    pub fn for_each_transition_all_candidate(
+        a: &ComputedValues,
+        b: &ComputedValues,
+        existing: &crate::properties::LonghandIdSet,
+        mut f: impl FnMut(LonghandId),
+    ) -> bool {
+        if a.effective_zoom != b.effective_zoom || !a.font_size_equals(b) {
+            return false;
+        }
+        <%
+            groups = []
+            for p in reversed(data.shorthands_by_name["all"].sub_properties):
+                if not p.animatable or p.logical:
+                    continue
+                if groups and groups[-1][0] is p.style_struct:
+                    groups[-1][1].append(p)
+                else:
+                    groups.append((p.style_struct, [p]))
+        %>
+        % for (style_struct, props) in groups:
+        if !std::ptr::eq(a.get_${style_struct.name_lower}(), b.get_${style_struct.name_lower}()) {
+            % for p in props:
+            f(LonghandId::${p.camel_case});
+            % endfor
+        } else if !existing.is_empty() {
+            % for p in props:
+            if existing.contains(LonghandId::${p.camel_case}) {
+                f(LonghandId::${p.camel_case});
+            }
+            % endfor
+        }
+        % endfor
+        true
+    }
+
     /// Update `style` with the value of this `AnimationValue`.
     ///
     /// SERVO ONLY: This doesn't properly handle things like updating 'em' units
