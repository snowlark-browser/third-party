+                let mut weight = percentage(input);
+                let palette = FontPalette::parse(context, input)?;
+                if weight.is_none() {
+                    weight = percentage(input);
+                }
+                items.push(generics::GenericPaletteMixItem {
+                    palette,
+                    percentage: weight,
