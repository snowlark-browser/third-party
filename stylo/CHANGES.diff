+        input.parse_nested_block(|input| {
+            let interpolation = input
+                .try_parse(|input| -> Result<_, ParseError> {
+                    let method = crate::color::mix::ColorInterpolationMethod::parse(context, input)?;
+                    input.expect_comma()?;
+                    Ok(method)
